<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.eucaue.flexa</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Flexa</name>
  <summary>Convert cursor themes</summary>
  <description>
    <p>
      Flexa is a GNOME application that converts cursor themes between
      Windows (.cur and .ani files) and Linux XCursor formats. It
      provides a clean, intuitive interface following the GNOME Human
      Interface Guidelines.
    </p>
    <p>
      Add multiple cursor folders at once — either through the file
      picker or by dragging and dropping them into the window. Flexa
      will scan each folder for cursors and convert them all with a
      single click. When done, a toast notification lets you open the
      output directory instantly.
    </p>
    <p>
      The output directory is configurable in Preferences and defaults
      to ~/.local/share/icons, so converted themes are immediately
      available in GNOME Settings → Appearance.
    </p>
  </description>

  <developer id="io.github.eucaue">
    <name>caue</name>
  </developer>

  <url type="homepage">https://github.com/eucaue/flexa</url>
  <url type="vcs-browser">https://github.com/eucaue/flexa</url>
  <url type="bugtracker">https://github.com/eucaue/flexa/issues</url>
  <url type="contribute">https://github.com/eucaue/flexa</url>

  <translation type="gettext">flexa</translation>
  <launchable type="desktop-id">io.github.eucaue.flexa.desktop</launchable>
  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#3584e4</color>
    <color type="primary" scheme_preference="dark">#3584e4</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/eucaue/flexa/v1.2.5/flexa.png</image>
      <caption>Windows cursor themes added for conversion to Linux</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="1.2.5" date="2026-11-02">
      <description translate="no">
        <p>New app icon</p>
        <ul>
          <li>Add a GNOME-style app icon with a symbolic variant</li>
          <li>Bundle the icon in the app resources for the About dialog and window</li>
        </ul>
      </description>
    </release>
    <release version="1.2.4" date="2026-11-01">
      <description translate="no">
        <p>Custom output folder fix</p>
        <ul>
          <li>Store custom output folders as host paths while keeping portal access</li>
          <li>Migrate portal paths saved by 1.2.3</li>
        </ul>
      </description>
    </release>
    <release version="1.2.3" date="2026-11-01">
      <description translate="no">
        <p>Localized output paths and Flathub fixes</p>
        <ul>
          <li>Resolve the Windows output directory from the XDG documents directory</li>
          <li>Show an error when the output folder cannot be created or written</li>
          <li>Complete the Brazilian Portuguese translation</li>
          <li>Update ImageMagick to 7.1.2-34 and trim the Flatpak package</li>
          <li>Refresh AppStream metadata, screenshots and README</li>
        </ul>
      </description>
    </release>
    <release version="1.2.2" date="2026-10-30">
      <description translate="no">
        <p>Scalable cursors for GNOME Shell 51</p>
        <ul>
          <li>Generate cursors_scalable with metadata.json for GNOME Shell 51</li>
          <li>Keep one image per scalable cursor using its real nominal size</li>
          <li>Skip truncated cursors and dangling aliases</li>
        </ul>
      </description>
    </release>
    <release version="1.2.1" date="2026-09-01">
      <description translate="no">
        <ul>
          <li>Discover cursor themes inside selected parent folders</li>
          <li>Load fallback cursor themes asynchronously</li>
          <li>Fix Pango markup escaping in folder names and subtitles</li>
          <li>Use default output directory when setting is empty</li>
        </ul>
      </description>
    </release>
    <release version="1.2.0" date="2026-07-20">
      <description translate="no">
        <p>OS-aware defaults and Windows installer</p>
        <ul>
          <li>OS-aware default output paths</li>
          <li>Windows installer with app icon and no console window</li>
          <li>Check ImageMagick version before conversion</li>
        </ul>
      </description>
    </release>
    <release version="1.1.0" date="2026-06-19">
      <description translate="no">
        <p>Bundled dependencies and packaging</p>
        <ul>
          <li>Flatpak bundles its own dependencies</li>
          <li>DEB packaging in CI</li>
        </ul>
      </description>
    </release>
    <release version="1.0.0" date="2026-05-29">
      <description translate="no">
        <p>Initial release</p>
        <ul>
          <li>Convert cursors between Windows and Linux formats</li>
          <li>Drag and drop support</li>
          <li>Multiple folder batch conversion</li>
          <li>Configurable output directory</li>
          <li>GSettings persistence</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
